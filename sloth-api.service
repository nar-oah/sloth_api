[Unit]
Description=Sloth AI Agent API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/sloth_api
EnvironmentFile=/home/admin/sloth_api/sloth-api.env
ExecStart=/usr/bin/python3 /home/admin/sloth_api/main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
