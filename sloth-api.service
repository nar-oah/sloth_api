[Unit]
Description=Sloth AI Agent API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin/sloth_api
EnvironmentFile=/home/admin/sloth_api/sloth-api.env
ExecStart=/home/admin/sloth_api/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8004
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
